{
  "name": "tryck",
  "version": "0.2.0",
  "description": "the trick to never writing try/catch again: typed results, generator composition, defects stay exceptions",
  "keywords": [
    "either",
    "error-handling",
    "errors",
    "generator",
    "result",
    "try-catch",
    "typescript"
  ],
  "homepage": "https://github.com/willzys/tryck#readme",
  "bugs": {
    "url": "https://github.com/willzys/tryck/issues"
  },
  "license": "Apache-2.0",
  "author": "Willian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willzys/tryck.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.lib.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "attw": "attw --pack . --profile esm-only",
    "compat": "tsc -p tests/compat && tsc -p tests/compat/tsconfig.strictest.json",
    "treeshake": "bun tests/compat/treeshake.ts",
    "pack:test": "bun tests/compat/pack.ts",
    "test": "bun test ./tests",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun test --coverage ./tests && bun run build && bun run attw && bun run compat && bun run treeshake && bun run pack:test",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "publint": "^0.3.25",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "ultracite": "^8.1.0",
    "zod": "^4.6.7"
  },
  "simple-git-hooks": {
    "commit-msg": "bunx commitlint --edit \"$1\""
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2"
}
